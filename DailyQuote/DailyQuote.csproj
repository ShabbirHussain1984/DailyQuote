<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DailyQuote</RootNamespace>
    <AssemblyTitle>Arabic Reader</AssemblyTitle>
    <Product>Arabic Reader</Product>
    <Version>1.0.0</Version>
    <!-- Run on a newer .NET Desktop Runtime if 8.0 is not installed. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

</Project>
